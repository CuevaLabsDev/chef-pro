# PostgreSQL connection
# Supabase pooled connection for ChefPro-AI:
# postgresql://postgres.tjwgeqmfuiembfnokbps:[DATABASE-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://your-user@localhost:5432/chefpro"
# Optional: direct Supabase host for migrations/seeds (bypasses session pooler limits)
# DIRECT_DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# NextAuth
AUTH_SECRET="replace-with-a-random-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@chefpro.app"

# Supabase Storage (for file uploads)
# SUPABASE_URL="https://tjwgeqmfuiembfnokbps.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google AI Studio — Gemini multi-agent system
# Get your key at https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3-flash-preview"

# Lobster Trap AI governance proxy (optional)
# Run: bash lobstertrap/start.sh to start the proxy
# Dashboard available at http://localhost:8080/_lobstertrap/ when running
LOBSTER_TRAP_URL=""
