generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── IdentityAccess Module ──────────────────────────────────────────

enum Role {
  fte
  ops
  kitchen_admin
  kitchen_admin_manager
  chef
  foh
}

enum PacketItemCategory {
  entree
  vegetarian_entree
  vegan_entree
  starches
  vegetables
  sides
  pastry
  back_up
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          Role     @default(chef)
  roleSubtypeId String?
  roleLabel     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  locationAccess  UserLocationAccess[]
  roleSubtype     RoleSubtype?            @relation(fields: [roleSubtypeId], references: [id], onDelete: SetNull)
  permissionRules UserPermissionOverride[]
  kitchenAdminManagerLinks KitchenAdminManagerAssignment[] @relation("KitchenAdminManager")
  managedKitchenAdminLinks KitchenAdminManagerAssignment[] @relation("KitchenAdminMember")
  tastingSessions TastingSession[]
  reviewActions   ReviewAction[]
  auditEvents     AuditEvent[]
  notifications   NotificationEvent[]
  exportJobs      ExportJob[]
  createdPackets  MenuSignagePacket[]     @relation("PacketCreatedBy")
  assignedPackets MenuSignagePacket[]     @relation("PacketAssignedTo")
  publishedPackets MenuSignagePacket[]    @relation("PacketPublishedBy")
  readyForFinalReviewPackets MenuSignagePacket[] @relation("PacketReadyForFinalReviewBy")
  finalizedForServicePackets MenuSignagePacket[] @relation("PacketFinalizedForServiceBy")
  packetReviewSignatures PacketReviewSignature[] @relation("PacketSignatureSigner")
  requestedAmendments    PacketAmendment[]       @relation("AmendmentRequester")
  resolvedAmendments     PacketAmendment[]       @relation("AmendmentResolver")
  pushSubscriptions      PushSubscription[]
  submittedCountSheets   DailyCountSheet[]       @relation("CountSheetSubmitter")
  amendedCountSheets     DailyCountSheet[]       @relation("CountSheetAmender")
}

model UserLocationAccess {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  subtypeDefaults RoleSubtypePermission[]
  userOverrides   UserPermissionOverride[]
}

model RoleSubtype {
  id                String   @id @default(cuid())
  role              Role
  code              String
  label             String
  rank              Int      @default(0)
  parentSubtypeCode String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users       User[]
  permissions RoleSubtypePermission[]
  parent      RoleSubtype?  @relation("SubtypeHierarchy", fields: [parentSubtypeCode], references: [code])
  children    RoleSubtype[] @relation("SubtypeHierarchy")

  @@unique([role, code])
  @@unique([code])
}

model RoleSubtypePermission {
  id           String   @id @default(cuid())
  subtypeId    String
  permissionId String
  isAllowed    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subtype    RoleSubtype @relation(fields: [subtypeId], references: [id], onDelete: Cascade)
  permission Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([subtypeId, permissionId])
}

model UserPermissionOverride {
  id           String   @id @default(cuid())
  userId       String
  permissionId String
  isAllowed    Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model KitchenAdminManagerAssignment {
  id             String   @id @default(cuid())
  managerId      String
  kitchenAdminId String
  createdAt      DateTime @default(now())

  manager      User @relation("KitchenAdminManager", fields: [managerId], references: [id], onDelete: Cascade)
  kitchenAdmin User @relation("KitchenAdminMember", fields: [kitchenAdminId], references: [id], onDelete: Cascade)

  @@unique([managerId, kitchenAdminId])
  @@index([managerId])
  @@index([kitchenAdminId])
}

// ─── Configuration Module ───────────────────────────────────────────

model Campus {
  id        String     @id @default(cuid())
  name      String     @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  buildings Building[]
}

model Building {
  id        String     @id @default(cuid())
  name      String
  campusId  String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  campus    Campus     @relation(fields: [campusId], references: [id], onDelete: Cascade)
  locations Location[]

  @@unique([campusId, name])
}

model Location {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  buildingId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  building             Building?            @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  userAccess           UserLocationAccess[]
  deadlineRules        DeadlineRule[]
  tastingSessions      TastingSession[]
  signagePackets       MenuSignagePacket[]
  countSheetTemplates  CountSheetTemplate[]
}

model TastingPeriod {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int
  isActive  Boolean @default(true)

  deadlineRules        DeadlineRule[]
  tastingSessions      TastingSession[]
  countSheetTemplates  CountSheetTemplate[]
}

model DeadlineRule {
  id              String   @id @default(cuid())
  locationId      String
  tastingPeriodId String
  deadlineTime    String   // HH:mm -- tasting submission deadline
  packetDueTime   String?  // HH:mm -- when signed packet must be returned to admin
  tastingStart    String?  // HH:mm -- when tasting window opens
  tastingEnd      String?  // HH:mm -- when tasting window closes
  serviceStart    String?  // HH:mm -- when service begins
  daysOfWeek      Int[]    @default([1, 2, 3, 4, 5])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  location      Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tastingPeriod TastingPeriod @relation(fields: [tastingPeriodId], references: [id], onDelete: Cascade)

  @@unique([locationId, tastingPeriodId])
}

model RatingSchema {
  id        String   @id @default(cuid())
  name      String
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  questions RatingQuestion[]
}

model RatingQuestion {
  id          String  @id @default(cuid())
  schemaId    String
  label       String
  description String?
  type        String  @default("star") // "star" | "select" | "text"
  scaleMin    Int?
  scaleMax    Int?
  options     String[] @default([])
  isRequired  Boolean @default(true)
  sortOrder   Int

  schema    RatingSchema    @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  responses RatingResponse[]
}

// ─── TastingCapture Module ──────────────────────────────────────────

model TastingSession {
  id                      String   @id @default(cuid())
  date                    DateTime
  locationId              String
  tastingPeriodId         String
  chefId                  String?
  managerName             String?
  menuName                String?
  status                  String   @default("draft") // "draft" | "submitted" | "reviewed" | "locked"
  checklistMenuPackage    Boolean  @default(false)
  checklistDigitalSignage Boolean  @default(false)
  checklistFoodCards      Boolean  @default(false)
  checklistNotes          String?
  submittedAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  location      Location      @relation(fields: [locationId], references: [id])
  tastingPeriod TastingPeriod @relation(fields: [tastingPeriodId], references: [id])
  chef          User?         @relation(fields: [chefId], references: [id])
  menuSignagePacket MenuSignagePacket?
  items         TastingItem[]
  reviewActions ReviewAction[]

  @@unique([date, locationId, tastingPeriodId, chefId])
}

model TastingItem {
  id                    String   @id @default(cuid())
  sessionId             String
  dishName              String
  sortOrder             Int
  temperatureCompliance String   @default("not_checked") // "compliant" | "non_compliant" | "not_checked"
  adjustmentsNeeded     String?
  ranOutTime            String?
  serviceGapMins        Int?
  backupNotes           String?
  fteNotes              String?
  photoUrl              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  session TastingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ratings RatingResponse[]
}

model RatingResponse {
  id           String @id @default(cuid())
  itemId       String
  questionId   String
  numericValue Float?
  textValue    String?

  item     TastingItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  question RatingQuestion @relation(fields: [questionId], references: [id])

  @@unique([itemId, questionId])
}

model MenuSignagePacket {
  id                      String   @id @default(cuid())
  date                    DateTime
  locationId              String
  meal                    String
  theme                   String?
  status                  String   @default("draft") // "draft" | "published" | "for_final_review" | "finalized_for_service"
  checklistMenuPackage    Boolean  @default(false)
  checklistDigitalSignage Boolean  @default(false)
  checklistFoodCards      Boolean  @default(false)
  checklistNotes          String?
  backupReady             Boolean  @default(false)
  backupUsed              Boolean  @default(false)
  backupNotes             String?
  createdById             String
  assignedChefId          String?
  publishedById           String?
  publishedAt             DateTime?
  readyForFinalReviewById String?
  readyForFinalReviewAt   DateTime?
  finalizedForServiceById String?
  finalizedForServiceAt   DateTime?
  tastingSessionId        String?  @unique
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  location              Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdBy             User           @relation("PacketCreatedBy", fields: [createdById], references: [id])
  assignedChef          User?          @relation("PacketAssignedTo", fields: [assignedChefId], references: [id])
  publishedBy           User?          @relation("PacketPublishedBy", fields: [publishedById], references: [id])
  readyForFinalReviewBy User?          @relation("PacketReadyForFinalReviewBy", fields: [readyForFinalReviewById], references: [id])
  finalizedForServiceBy User?          @relation("PacketFinalizedForServiceBy", fields: [finalizedForServiceById], references: [id])
  tastingSession        TastingSession? @relation(fields: [tastingSessionId], references: [id], onDelete: SetNull)
  items                 MenuSignageItem[]
  reviewSignatures      PacketReviewSignature[]
  amendments            PacketAmendment[]

  @@unique([date, locationId, meal])
  @@index([locationId, date])
  @@index([status])
}

model MenuSignageItem {
  id                String             @id @default(cuid())
  packetId          String
  category          PacketItemCategory
  itemName          String
  ingredients       String
  theme             String?
  dietTags          String[]           @default([])
  allergenTags      String[]           @default([])
  sortOrder         Int
  isReadyForService Boolean            @default(false)
  wasUsed           Boolean            @default(false)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  packet     MenuSignagePacket @relation(fields: [packetId], references: [id], onDelete: Cascade)
  amendments PacketAmendment[]

  @@index([packetId, category])
}

model PacketReviewSignature {
  id              String   @id @default(cuid())
  packetId        String
  signerId        String
  signerNameInput String
  signerRole      String
  createdAt       DateTime @default(now())

  packet MenuSignagePacket @relation(fields: [packetId], references: [id], onDelete: Cascade)
  signer User              @relation("PacketSignatureSigner", fields: [signerId], references: [id], onDelete: Cascade)

  @@unique([packetId, signerId])
  @@index([packetId, createdAt])
}

model PacketAmendment {
  id            String    @id @default(cuid())
  packetId      String
  type          String    // "item_change" | "backup_swap" | "item_removed" | "item_added"
  reason        String    // "tasting_feedback" | "prep_change" | "service_change" | "correction"
  description   String
  itemId        String?
  requestedById String
  resolvedById  String?
  status        String    @default("pending") // "pending" | "applied" | "dismissed"
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  packet      MenuSignagePacket @relation(fields: [packetId], references: [id], onDelete: Cascade)
  item        MenuSignageItem?  @relation(fields: [itemId], references: [id], onDelete: SetNull)
  requestedBy User              @relation("AmendmentRequester", fields: [requestedById], references: [id])
  resolvedBy  User?             @relation("AmendmentResolver", fields: [resolvedById], references: [id])

  @@index([packetId, status])
  @@index([packetId, createdAt])
}

// ─── DailyCounts Module ─────────────────────────────────────────────

enum CountSheetStatus {
  draft
  submitted
}

model CountSheetTemplate {
  id              String   @id @default(cuid())
  locationId      String
  tastingPeriodId String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  location      Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tastingPeriod TastingPeriod        @relation(fields: [tastingPeriodId], references: [id], onDelete: Cascade)
  sections      CountSheetSection[]
  sheets        DailyCountSheet[]

  @@unique([locationId, tastingPeriodId])
}

model CountSheetSection {
  id         String  @id @default(cuid())
  templateId String
  label      String
  group      String?
  fields     Json
  sortOrder  Int
  isActive   Boolean @default(true)

  template CountSheetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  entries  DailyCountEntry[]

  @@unique([templateId, sortOrder])
}

model DailyCountSheet {
  id            String           @id @default(cuid())
  templateId    String
  date          DateTime         @db.Date
  status        CountSheetStatus @default(draft)
  submittedById String?
  submittedAt   DateTime?
  amendedById   String?
  amendedAt     DateTime?
  amendReason   String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  template    CountSheetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  submittedBy User?              @relation("CountSheetSubmitter", fields: [submittedById], references: [id])
  amendedBy   User?              @relation("CountSheetAmender", fields: [amendedById], references: [id])
  entries     DailyCountEntry[]

  @@unique([templateId, date])
  @@index([date])
}

model DailyCountEntry {
  id        String @id @default(cuid())
  sheetId   String
  sectionId String
  values    Json   @default("{}")

  sheet   DailyCountSheet   @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  section CountSheetSection @relation(fields: [sectionId], references: [id])

  @@unique([sheetId, sectionId])
}

// ─── ReviewCompliance Module ────────────────────────────────────────

model ReviewAction {
  id         String   @id @default(cuid())
  sessionId  String
  reviewerId String
  fromStatus String
  toStatus   String
  notes      String?
  createdAt  DateTime @default(now())

  session  TastingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewer User           @relation(fields: [reviewerId], references: [id])
}

// ─── Audit Module (Cross-cutting) ───────────────────────────────────

model AuditEvent {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String
  actorName  String
  fieldName  String?
  oldValue   String?
  newValue   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ─── Notification Module (Cross-cutting) ────────────────────────────

model NotificationEvent {
  id                String   @id @default(cuid())
  type              String
  recipientId       String
  channel           String   @default("in_app") // "email" | "google_chat" | "in_app"
  subject           String
  body              String
  status            String   @default("pending") // "pending" | "sent" | "failed"
  relatedEntityType String?
  relatedEntityId   String?
  sentAt            DateTime?
  createdAt         DateTime @default(now())

  recipient User @relation(fields: [recipientId], references: [id])

  @@index([recipientId, status])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Reporting Module (Cross-cutting) ───────────────────────────────

model ExportJob {
  id            String    @id @default(cuid())
  type          String
  format        String
  filters       Json      @default("{}")
  requestedById String
  status        String    @default("queued") // "queued" | "processing" | "completed" | "failed"
  fileUrl       String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  requestedBy User @relation(fields: [requestedById], references: [id])
}
